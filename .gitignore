# Go
/bin/
*.exe
*.test
*.out
vendor/

# Env / secrets — never commit these
.env
.env.*
*.tfvars
!*.example.tfvars

# Terraform state (holds infra details + can hold secrets)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Model artifacts (large; pulled from BlunderNet, not versioned here)
*.onnx
*.pt
*.pth

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json

# local build outputs
/api
/worker

# frontend
web/node_modules/
web/dist/*
!web/dist/.gitkeep
!models/.gitkeep
.terraform.lock.hcl

# demo stack terraform state
deploy/demo/.terraform/
deploy/demo/.terraform.lock.hcl
