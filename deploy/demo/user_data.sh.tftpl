#!/bin/bash
# Boots the demo box: Docker, the two app images from ECR, Postgres and
# Redis alongside them, and Caddy in front. Runs on every fresh instance.
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker

mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL https://github.com/docker/compose/releases/download/v2.32.4/docker-compose-linux-aarch64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

mkdir -p /opt/blundernet

# The database lives on a volume that outlives this instance. Wait for the
# attachment, format it only if it has never been used, and mount it. Doing
# this by NVMe serial rather than device name because Nitro renames /dev/sdf.
DATA_DEV=""
for _ in $(seq 1 60); do
  for candidate in /dev/nvme?n1; do
    [ -b "$candidate" ] || continue
    # The root volume is the one carrying a mounted filesystem already.
    if ! lsblk -no MOUNTPOINTS "$candidate" | grep -q '/$'; then
      DATA_DEV="$candidate"
      break
    fi
  done
  [ -n "$DATA_DEV" ] && break
  sleep 5
done

if [ -n "$DATA_DEV" ]; then
  # blkid exits non-zero on an unformatted device, which is how a first boot
  # is told apart from a replacement that should keep its data.
  if ! blkid "$DATA_DEV" >/dev/null 2>&1; then
    mkfs -t xfs "$DATA_DEV"
  fi
  mkdir -p /var/lib/blundernet
  mount "$DATA_DEV" /var/lib/blundernet
  echo "$DATA_DEV /var/lib/blundernet xfs defaults,nofail 0 2" >> /etc/fstab
  mkdir -p /var/lib/blundernet/pgdata
else
  echo "no data volume found; falling back to instance storage" >&2
  mkdir -p /var/lib/blundernet/pgdata
fi

# Caddy terminates TLS automatically when a domain is set; without one it
# just proxies plain HTTP on port 80.
%{ if domain != "" ~}
cat >/opt/blundernet/Caddyfile <<'CADDY'
${domain}, www.${domain} {
  reverse_proxy api:8080
}
CADDY
%{ else ~}
cat >/opt/blundernet/Caddyfile <<'CADDY'
:80 {
  reverse_proxy api:8080
}
CADDY
%{ endif ~}

cat >/opt/blundernet/compose.yaml <<'COMPOSE'
services:
  postgres:
    image: postgres:17-alpine
    # Tuned for the box rather than for a default machine, and these numbers
    # are for the t4g.small in var.instance_type. Moving the instance type
    # without moving these leaves the planner working from the wrong picture,
    # so they belong in the same change.
    #
    # random_page_cost of 4 is priced for a spinning disk rather than gp3, and
    # the default 128MB of shared_buffers on a 2GB box leaves the corpus to the
    # OS cache alone. Found by load testing the puzzle search, which was I/O
    # bound on the old t4g.micro: 2,599 reads a second at 92% disk utilization
    # against a 1,095MB heap and 910MB of RAM. Two gigabytes fits it.
    command:
      - postgres
      - -c
      - shared_buffers=512MB
      - -c
      - effective_cache_size=1280MB
      - -c
      - random_page_cost=1.1
      - -c
      - maintenance_work_mem=128MB
    restart: unless-stopped
    environment:
      POSTGRES_USER: blundernet
      POSTGRES_PASSWORD: blundernet
      POSTGRES_DB: blundernet
    volumes:
      - /var/lib/blundernet/pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U blundernet"]
      interval: 5s
      timeout: 3s
      retries: 20

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    command: ["redis-server", "--maxmemory", "128mb", "--maxmemory-policy", "allkeys-lru"]
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 20

  api:
    image: ${api_image}
    restart: unless-stopped
    environment: &appenv
      REDIS_URL: redis://redis:6379
      DATABASE_URL: postgres://blundernet:blundernet@postgres:5432/blundernet
      # burst,per-second. A drill fetches ten puzzles at a time, so one person
      # searches about once a minute, but signed-out visitors share a bucket by
      # address and the old 30,1 throttled a whole office or campus together.
      RATE_LIMIT_PUZZLES: 60,5
      SQS_QUEUE_URL: ${queue_url}
      AWS_REGION: ${region}
      # Caddy terminates the connection, so X-Forwarded-For here is written
      # by our own proxy rather than by the client.
      TRUST_PROXY: "true"
      # Only mark session cookies Secure once Caddy has a certificate. On the
      # bare-IP deployment the site is plain http and a Secure cookie would be
      # dropped, so nobody could stay signed in.
%{ if domain != "" ~}
      SECURE_COOKIES: "true"
%{ else ~}
      SECURE_COOKIES: "false"
%{ endif ~}
    depends_on:
      postgres: { condition: service_healthy }
      redis: { condition: service_healthy }

  worker:
    image: ${worker_ig}
    restart: unless-stopped
    environment:
      <<: *appenv
      ENGINE_SIMS: "${engine_sims}"
    depends_on:
      postgres: { condition: service_healthy }
      redis: { condition: service_healthy }

  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /opt/blundernet/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddydata:/data
    depends_on:
      - api

volumes:
  caddydata:
COMPOSE

aws ecr get-login-password --region ${region} \
  | docker login --username AWS --password-stdin ${registry}

# The images may not be pushed yet on a first deploy, so keep retrying
# rather than leaving the box empty until someone notices.
for attempt in $(seq 1 60); do
  if docker compose -f /opt/blundernet/compose.yaml pull; then break; fi
  echo "image pull failed (attempt $attempt), retrying in 30s"
  sleep 30
done
docker compose -f /opt/blundernet/compose.yaml up -d

# Re-pull and restart on boot so the stack survives reboots and picks up
# newly pushed images.
cat >/etc/systemd/system/blundernet.service <<'UNIT'
[Unit]
Description=BlunderNet demo stack
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/blundernet
ExecStart=/usr/bin/docker compose -f /opt/blundernet/compose.yaml up -d
ExecStop=/usr/bin/docker compose -f /opt/blundernet/compose.yaml down

[Install]
WantedBy=multi-user.target
UNIT
systemctl enable blundernet.service

# Nightly database backup to S3. Installed here rather than by hand, so a
# replaced instance comes back with its backups still running: a backup that
# exists because somebody remembered to set it up once is not a backup.
cat >/opt/blundernet/backup.sh <<'BACKUP'
#!/usr/bin/env bash
# Nightly database backup: pg_dump out of the running container, gzip, and put
# it in S3 under a dated key.
#
# A dump rather than an EBS snapshot on purpose. A snapshot copies the whole
# volume, is tied to this account and region, and restoring one means building
# an instance around it. A 40MB gzip of SQL restores into any Postgres,
# including a laptop, which is what makes it testable. Testing the restore is
# the only thing that separates a backup from a hope.
set -euo pipefail

BUCKET="$${BACKUP_BUCKET:-blundernet-backups-222210925967}"
STAMP="$(date -u +%Y-%m-%dT%H-%M-%SZ)"
KEY="pg/blundernet-$${STAMP}.sql.gz"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# --clean --if-exists so a restore drops what it is replacing rather than
# erroring on objects that already exist.
docker exec blundernet-postgres-1 pg_dump -U blundernet --clean --if-exists blundernet \
  | gzip -9 > "$TMP/dump.sql.gz"

SIZE=$(stat -c %s "$TMP/dump.sql.gz")
# A dump that comes back tiny means pg_dump failed halfway and the pipe still
# succeeded. Refuse to upload it over a good one.
if [ "$SIZE" -lt 100000 ]; then
  echo "dump is only $${SIZE} bytes, refusing to upload" >&2
  exit 1
fi

aws s3 cp "$TMP/dump.sql.gz" "s3://$${BUCKET}/$${KEY}" --only-show-errors
echo "backed up $${SIZE} bytes to s3://$${BUCKET}/$${KEY}"
BACKUP
chmod +x /opt/blundernet/backup.sh

cat >/etc/systemd/system/blundernet-backup.service <<'UNIT'
[Unit]
Description=Back up the BlunderNet database to S3
After=docker.service

[Service]
Type=oneshot
ExecStart=/opt/blundernet/backup.sh
UNIT

cat >/etc/systemd/system/blundernet-backup.timer <<'UNIT'
[Unit]
Description=Nightly BlunderNet database backup

[Timer]
# 03:15 UTC, which is the middle of the night in Houston and nowhere near a
# deploy. RandomizedDelaySec so a fleet would not all dump at once.
OnCalendar=*-*-* 03:15:00
RandomizedDelaySec=600
Persistent=true

[Install]
WantedBy=timers.target
UNIT

systemctl enable --now blundernet-backup.timer

